# Public build configuration only. Never put credentials or tokens here.
EXPO_PUBLIC_LATCH_MODE=demo
# Verified IFSS namespace (public, not a credential); also the app's default.
# The native transport is pinned to https://api.eu.openpath.com/.
EXPO_PUBLIC_ALTA_NAMESPACE=org:ifss-group

# Public Sentry ingest DSN. The actual local value is in ignored .env.local.
EXPO_PUBLIC_SENTRY_DSN=
# Optional release override; set SENTRY_RELEASE to the same value for map uploads.
# EXPO_PUBLIC_SENTRY_RELEASE=latch@1.0.0
# Temporary demo/development-only verification control; leave off normally.
# EXPO_PUBLIC_SENTRY_VERIFY=1
# Build-time source-map authentication belongs in a local/EAS secret named
# SENTRY_AUTH_TOKEN. Never prefix it with EXPO_PUBLIC_ or commit its value.
