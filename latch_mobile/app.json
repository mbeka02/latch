{
  "expo": {
    "name": "Latch",
    "slug": "latch",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/branding/icon.png",
    "scheme": "latch",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/branding/icon.png"
    },
    "android": {
      "package": "com.mbeka02.latch",
      "allowBackup": false,
      "adaptiveIcon": {
        "backgroundColor": "#111111",
        "foregroundImage": "./assets/branding/adaptive-foreground.png",
        "monochromeImage": "./assets/branding/adaptive-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/branding/favicon.png"
    },
    "plugins": [
      ["expo-router", { "sitemap": false }],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#111111",
          "image": "./assets/branding/splash-mark.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ],
      "expo-secure-store",
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "organization": "mbeka02",
          "project": "latch-mobile",
          "experimental_android": {
            "enableAndroidGradlePlugin": false
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "a2756ebf-3842-4633-8f28-7837bc0137fe"
      }
    },
    "owner": "mbeka02"
  }
}
