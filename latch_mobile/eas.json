{
  "cli": {
    "version": ">= 27.10.0",
    "appVersionSource": "remote",
    "requireCommit": true
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "developmentClient": false,
      "environment": "preview",
      "node": "24.21.0",
      "autoIncrement": true,
      "android": {
        "buildType": "apk",
        "credentialsSource": "remote"
      },
      "env": {
        "EXPO_PUBLIC_LATCH_MODE": "live",
        "EXPO_PUBLIC_ALTA_NAMESPACE": "org:ifss-group",
        "EXPO_PUBLIC_SENTRY_VERIFY": "0"
      }
    }
  }
}
