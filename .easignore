# EAS uses this instead of all repository .gitignore files.
# Keep local credentials, tooling and verification artifacts out of cloud uploads.
.git/
.agents/
.codex/
**/node_modules/
**/coverage/
**/.expo/
**/dist/
**/web-build/
**/expo-env.d.ts
**/.kotlin/
**/.gradle/
**/build/
**/*.orig.*
**/*.jks
**/*.keystore
**/*.p8
**/*.p12
**/*.key
**/*.pem
**/*.mobileprovision
**/credentials.json
**/.sentryclirc
**/.env*
**/.DS_Store
**/*.tsbuildinfo
**/npm-debug.*
**/yarn-debug.*
**/yarn-error.*
**/.metro-health-check*
**/*.apk
**/*.aab

# App native projects are generated by Prebuild; retain modules/**/android source.
/latch_mobile/android/
/latch_mobile/ios/
/latch_mobile/example/

# These are source/review material, not build inputs.
/*.md
/latch_mobile/docs/
/latch_mobile/src/__tests__/
/latch_mobile/src/**/*.test.ts
/latch_mobile/src/**/*.test.tsx
/latch_mobile/modules/**/transport-tests/
/latch_mobile/jest.config.js
/latch_mobile/jest.setup.js
